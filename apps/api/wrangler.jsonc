{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wison-knowledge-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_VERSION": "0.1.0"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/company-assets/*"]
  },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "wison-knowledge-files-dev" },
    { "binding": "QUARANTINE_FILES", "bucket_name": "wison-knowledge-quarantine-dev" }
  ],
  "env": {
    "uat": {
      "name": "wison-knowledge-platform",
      "vars": {
        "APP_VERSION": "0.1.0-uat",
        "CLOUDFLARE_ACCESS_AUD": "5ec1f0354a9e2aaf29ef0d9b04103f7471a3e517c9c796bf5208ef52d8182624",
        "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://849943802.cloudflareaccess.com"
      },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "146f2845cb004780b6355543b97b47ec" }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "wison-knowledge-files-uat" },
        { "binding": "QUARANTINE_FILES", "bucket_name": "wison-knowledge-quarantine-uat" }
      ]
    }
  }
}
